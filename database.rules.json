{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || newData.val() === null)"
      }
    },
    "accounts": {
      ".read": "auth != null",
      "developer": {
        "$uid": {
          ".write": "auth != null && $uid === auth.uid"
        }
      },
